# ==============================================================================
# Learnify Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Exposed to the browser via import.meta.env
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Edge Functions Secrets
# ------------------------------------------------------------------------------
# NEVER commit real API keys to git or place them in frontend client code.
# Edge Function secrets are stored in your Supabase project vault and accessed
# server-side only in Edge Functions (e.g. generate-questions).
#
# Supported Models:
# - GEMINI_MODEL: gemini-1.5-flash (default), gemini-1.5-pro, gemini-2.0-flash
# - GROQ_MODEL: llama-3.3-70b-versatile (default), llama-3.1-8b-instant, mixtral-8x7b-32768
#
# Set these secrets in your Supabase project via CLI:
#   supabase secrets set GEMINI_API_KEY="your-gemini-api-key"
#   supabase secrets set GEMINI_MODEL="gemini-1.5-flash"
#   supabase secrets set GROQ_API_KEY="your-groq-api-key"
#   supabase secrets set GROQ_MODEL="llama-3.3-70b-versatile"

# ------------------------------------------------------------------------------
# 3. Deployment & Setup Commands
# ------------------------------------------------------------------------------
# Step A: Push database schema, RLS policies, and RPC functions
#   supabase db push
#
# Step B: Set server-side AI provider secrets
#   supabase secrets set GEMINI_API_KEY="your-gemini-api-key"
#   supabase secrets set GEMINI_MODEL="gemini-1.5-flash"
#   supabase secrets set GROQ_API_KEY="your-groq-api-key"
#   supabase secrets set GROQ_MODEL="llama-3.3-70b-versatile"
#
# Step C: Deploy the Question Generation Edge Function
#   supabase functions deploy generate-questions
